# ─────────────────────────────────────────────
# HireMatch AI — Environment Variables Template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_DB=hirematch
POSTGRES_USER=hirematch_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_PORT=5432

# ── Spring Boot ───────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/hirematch
SPRING_DATASOURCE_USERNAME=hirematch_user
SPRING_DATASOURCE_PASSWORD=changeme_strong_password

# JWT
JWT_SECRET=changeme_at_least_64_char_random_secret_for_HS512_algorithm_here_!!
JWT_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# File storage (local by default; set to S3 for prod)
STORAGE_TYPE=local
STORAGE_PATH=/app/uploads
# S3 (optional)
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Spring Mail (optional for reminders)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@hirematch.ai

# AI Service URL (internal docker network)
AI_SERVICE_URL=http://ai-service:8000

# ── AI Service ────────────────────────────────
# Set to true to load genuine sentence-transformers/all-MiniLM-L6-v2 embeddings (384-dim)
ENABLE_LOCAL_EMBEDDER=true
# HuggingFace token for model downloads (optional for public models)
HF_TOKEN=

# Gemini API Key for LLM resume parsing and coach enhancements
GEMINI_API_KEY=

# Optional OpenAI provider fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Job Providers ─────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
REMOTIVE_ENABLED=true

# ── Matching weights (must sum to 1.0) ────────
# overall = 0.50 * semantic + 0.30 * skill + 0.10 * experience + 0.10 * location
MATCH_WEIGHT_SEMANTIC=0.50
MATCH_WEIGHT_SKILL=0.30
MATCH_WEIGHT_EXPERIENCE=0.10
MATCH_WEIGHT_LOCATION=0.10

# ── Frontend ──────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=HireMatch AI
# Google OAuth Client ID (Optional)
VITE_GOOGLE_CLIENT_ID=

# ── Firebase Authentication (for real Google Login) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=100
RATE_LIMIT_REFILL_PERIOD_SECONDS=60
